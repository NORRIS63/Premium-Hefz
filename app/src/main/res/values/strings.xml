    <!-- Asma ul Husna -->
    <string name="asma_title">Asma ul Husna</string>
    <string name="asma_sub">99 names · Arabic + meaning</string>
    <string name="asma_loading">Loading the names…</string>
    <string name="asma_unavailable">Couldn’t load the names. Connect to the internet once to load them.</string>
    <string name="asma_retry">Retry</string>
    <string name="asma_offline">Offline · showing the saved names</string>
    <string name="asma_note">The 99 names below follow the popular traditional list. The count of ninety-nine is sound (Bukhari, Muslim), but this specific enumeration comes from Tirmidhi 3507, which al-Tirmidhi himself graded gharib — and it differs from that enumeration by one name: Al-Ahad appears here but not there (there, the count of 99 includes Allah itself). Allah’s names are not limited to these 99.</string>
    <string name="asma_footer">Source: AlAdhan API (aladhan.com). Bengali meanings are not yet available.</string>
