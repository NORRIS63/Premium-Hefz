<?xml version="1.0" encoding="utf-8"?>
<!-- Progress and settings are backed up. The 43 MB page folder is not: it can be re-imported and is
     larger than the cloud backup quota. -->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
    <exclude domain="file" path="pages" />
</full-backup-content>
