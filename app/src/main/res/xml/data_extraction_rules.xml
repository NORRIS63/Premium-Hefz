<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Only the database and shared preferences are extracted. App files are never included,
         so the 43 MB page folder (files/pages) is neither backed up nor transferred: it
         re-extracts from the bundled asset on the new device. -->
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
